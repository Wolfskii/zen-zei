# Bind
ZENZEI_HOST=0.0.0.0
# Host port published for LAN / Dokploy. Containers listen on 8080.
ZENZEI_HOST_PORT=38136

# Postgres (compose builds DATABASE_URL from these for the app service)
POSTGRES_USER=zenzei
POSTGRES_PASSWORD=zenzei
POSTGRES_DB=zenzei

# Local `npm run dev` only. Docker Compose always talks to zenzei-db and ignores this URL.
DATABASE_URL=postgres://zenzei:zenzei@localhost:5432/zenzei

# Public origin on Dokploy (https://zen-zei.example.com). Needed for CSRF / absolute URLs.
# ORIGIN=https://zen-zei.example.com

# Optional for `/admin`. Empty = the admin page cannot unlock. Use a long random value in production.
ZENZEI_ADMIN_API_KEY=dev-admin-key

# Docker Compose overrides this to /data/uploads. Local `npm run dev` uses ./data/uploads.
ZENZEI_UPLOAD_DIR=./data/uploads

# Seed built-in Rain + Thunder (+ a few YouTube loops) on boot. Set 0 to skip.
ZENZEI_SEED=1

# Upload limits (bytes). adapter-node BODY_SIZE_LIMIT must be larger than audio.
ZENZEI_MAX_AUDIO_BYTES=20971520
ZENZEI_MAX_COVER_BYTES=2097152
BODY_SIZE_LIMIT=25M
